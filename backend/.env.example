APP_NAME=OrbitSRM
APP_VERSION=1.1.0
DATA_DIR=./data
MAX_UPLOAD_MB=200
MAX_RASTER_WIDTH=20000
MAX_RASTER_HEIGHT=20000
MAX_RASTER_PIXELS=100000000
MAX_BASELINE_OUTPUT_PIXELS=100000000
METRIC_CHUNK_SIZE=512
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MODEL_CHECKPOINT=
DEVICE=auto

# Optional OpenSR (LDSR-S2) inference. Disabled by default; see requirements-opensr.txt.
# OPENSR_DEVICE=auto means "CUDA only" and never falls back to CPU. Use cpu to opt in explicitly.
OPENSR_ENABLED=false
OPENSR_CHECKPOINT=
OPENSR_DEVICE=auto
OPENSR_SAMPLING_STEPS=100
OPENSR_MAX_SAMPLING_STEPS=100
OPENSR_WINDOW=128
OPENSR_MAX_WINDOW_SIZE=256
OPENSR_OVERLAP=12
OPENSR_BATCH_SIZE=1
OPENSR_MAX_BATCH_SIZE=4
OPENSR_DN_SCALE=10000
OPENSR_MAX_TILES=4096
OPENSR_TORCH_THREADS=0
